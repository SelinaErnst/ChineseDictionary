<DictionaryChooser>:
    options: options
    # directory: app.get_setting('dict_directory')
    MDAnchorLayout:
        padding: 50
        anchor_y: 'top'
        MDStackLayout:
            spacing: 20
            TitleLabel:
                text: "Dictionaries"
            LazyOptions:
                id: options
                itemclass: 'MyMultiLineItem'  #MyListItem MyMultiLineItem
                scroll_spacing: 30 
                size_hint_y: 1