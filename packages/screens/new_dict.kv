<DictionaryNew>:
    MDStackLayout: 
        padding: 50,50,50,0
        spacing: 20
        TitleLabel:
            text: f"Create New Dictionary"
        MDBoxLayout:
            radius: app.radius
            padding: 40,60,40,40
            spacing: 60
            md_bg_color: app.custom.colors['dialog_bg']
            orientation: 'vertical'
            size_hint_x: 1
            adaptive_height: True
            EntryField:
                id: name_entry
                hint: "Choose a name"
                role: "medium"
                # text: root.dict_name
                is_correct: root.check_name
                multiline: False
            MDBoxLayout:
                adaptive_height: True
                spacing: 20
                Widget:
                RigidIconTextButton:
                    width: 300
                    text: "Add"
                    icon: "plus"    
                    style: "tonal"
                    on_press: root.create()
