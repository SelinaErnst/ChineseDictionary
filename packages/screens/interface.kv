<Interface>:
    wm: wm.__self__
    orientation: 'vertical'
    
    MDTopAppBar:
        type: 'small'
        theme_bg_color: "Custom"
        md_bg_color: app.custom.colors['app']
        size_hint_y: None
        height: 150
        MDTopAppBarLeadingButtonContainer:
            MDActionTopAppBarButton:
                icon: "menu"
                size_hint: None, None
                size: 120, 120
                on_release: nav_drawer.set_state("toggle")
                theme_icon_color: 'Custom'
                icon_color: "white"

        MDTopAppBarTitle:
            text: "ChineseDictionary"
            halign: "center"
            style: 'Label'
            role: 'small'
            theme_text_color: "Custom"
            text_color: "white"
            
        MDTopAppBarTrailingButtonContainer:
            MDActionTopAppBarButton:
                icon: "dots-vertical"
                size_hint: None, None
                size: 120, 120
                on_release: app.wm.current_screen.bottom_nav.set_state("toggle") if hasattr(app.wm.current_screen,'bottom_nav') else None
                theme_icon_color: 'Custom'
                icon_color: "white"

    MDNavigationLayout:
        WindowManager:
            id: wm
            md_bg_color: app.custom.colors['bg']

        MyNavigationDrawer:
            id: nav_drawer
            radius: 0, app.radius, app.radius, 0
            drawer_type: 'modal'
            anchor: 'left'
            MDNavigationDrawerMenu:
                spacing: 5
                MDNavigationDrawerLabel:
                    text: "Menu"
                MDNavigationDrawerDivider:
                NavigationButton:
                    on_release:
                        app.previous_screen()
                        nav_drawer.set_state("toggle")
                    icon: "arrow-left"
                    text: "Go Back"
                NavigationButton:
                    on_release: 
                        app.switch_screen('home','down')
                        nav_drawer.set_state("toggle")
                    icon: "home"
                    text: "Home"
                NavigationButton:
                    on_release: 
                        app.switch_screen('settings','down')
                        nav_drawer.set_state("toggle")
                    icon: "cog-outline"
                    text: "Settings"
                NavigationButton:
                    on_release: 
                        app.show_info('Metrics',app.get_metrics())
                        nav_drawer.set_state("toggle")
                    icon: "information"
                    text: "Information"
                MDNavigationDrawerDivider:
                NavigationButton:
                    on_release: 
                        app._MyApp__show_validation_dialog()
                        nav_drawer.set_state("toggle")
                    icon: "account-check"
                    text: "Access"
                NavigationButton:
                    on_release: 
                        app.reload()
                        nav_drawer.set_state("toggle")
                    icon: "reload"
                    text: "Reload"
                NavigationButton:
                    on_release: 
                        app.backup()
                        nav_drawer.set_state("toggle")
                    icon: "download"
                    text: "Backup"

                NavigationButton:
                    on_release: 
                        app.restore()
                        nav_drawer.set_state("toggle")
                    icon: "upload"
                    text: "Restore"

<MyNavigationDrawer@MDNavigationDrawer>:
    width: dp(200) if Window.width <= dp(360) else dp(200)
