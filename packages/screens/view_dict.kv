

<ViewDict>:
    rv_scroll: rv_scroll
    grid: grid
    bottom_nav: bottom_nav

    search_entry: search_entry
    search_filter: search_filter
    search_button: header.search_button

    filter: filter
    filter_box: filter_box
    filter_button: header.filter_button

    sorter: sorter
    sorter_box: sorter_box
    sorter_button: header.sorter_button

    MDAnchorLayout:
        # orientation: 'vertical'
        anchor_y: 'top'
        MDRecycleView:
            id: rv_scroll
            viewclass: 'DictionaryItem'
            scroll_type: ['bars', 'content']
            bar_width: 20
            do_scroll_x: False
            do_scroll_y: True
            RecycleBoxLayout:
                id: grid
                padding: 30,kopf.height+2*30,30,300
                orientation: "vertical"
                spacing: 30
                size_hint: 1, None
                height: self.minimum_height
                default_size_hint: 1, None
                # default_height: 300
                default_height: None
        BlockingAnchorLayout:
            size_hint_y: None
            height: kopf.height+2*30
            MDBoxLayout:
                id: kopf
                radius: app.radius
                adaptive_height: True
                orientation: 'vertical'
                md_bg_color: app.custom.colors['head']
                size_hint_x: None
                width: Window.width-2*60
                padding: 20,0,20,0
                DictNameWithButtons:
                    id: header
                    left_text: root.dict_name
                    right_text: str(root.entry_count)
                    padding: 0,20,20,20
                    not_filter: filter.include == [] and filter.exclude == []
                    not_search: search_entry.text == ""
                MDBoxLayout:
                    id: sorter_box
                    size_hint_y: None
                    height: sorter.height
                    Sorter:
                        id: sorter
                        md_bg_color:
                        padding: 0,0,0,10
                        sorter_icons: {'simple':'','traditional':'','pronunciation':'','switch':{'ascending':'sort-ascending','descending':'sort-descending'}}
                MDAnchorLayout:
                    id: search_filter
                    size_hint_y: None
                    height: search_entry.height+20
                    anchor_y: 'top'
                    orientation: 'vertical'
                    padding: 0,0,0,0
                    SearchBar:
                        id: search_entry
                        on_text: root.set_list_items(search_text=self.text)
                MDBoxLayout:
                    id: filter_box
                    size_hint_y: None
                    height: filter.height
                    Filter:
                        id: filter
                        padding: 0,0,0,10
                        filter_icons: root.filter_icons

    MDBottomSheet:
        id: bottom_nav
        radius: 0
        size_hint: None,None
        height: 170
        width: Window.width 
        sheet_type: "standard"
        md_bg_color: app.custom.colors['clear']

        BottomSheetDragHandleContainer:
            MDAnchorLayout:
                anchor_x: 'center'
                anchor_y: 'center'
                size_hint_y: None
                height: bottom_nav.height
                md_bg_color: app.custom.colors['clear']
                MDBoxLayout:
                    orientation: 'horizontal'
                    adaptive_width: True
                    size_hint_y: None
                    height: bottom_nav.height-20
                    spacing: 50
                    padding: 50,50
                    md_bg_color: app.custom.colors['head']
                    radius: app.radius
                    BigIconButton:
                        text: 'Delete'
                        icon: 'delete'
                        style: 'text'
                        size: bottom_nav.height-60, bottom_nav.height-60
                        md_bg_color: app.custom.colors['clear']
                        on_release: root.del_dictionary()
                    BigIconButton:
                        text: 'Add'
                        icon: 'plus'
                        size: bottom_nav.height-60, bottom_nav.height-60
                        style: 'text'
                        md_bg_color: app.custom.colors['clear']
                        on_release: root.add_character()
                    BigIconButton:
                        text: 'Export'
                        icon: 'download'
                        style: 'text'
                        size: bottom_nav.height-60, bottom_nav.height-60
                        md_bg_color: app.custom.colors['clear']
                        on_release: root.export()
                    BigIconButton:
                        text: 'Save'
                        icon: 'content-save'
                        style: 'text'
                        size: bottom_nav.height-60, bottom_nav.height-60
                        md_bg_color: app.custom.colors['clear']
                        on_release: root.save_dictionary(output='jsonl',make_msg=False)
                    BigIconButton:
                        text: 'Edit'
                        icon: 'pencil'
                        style: 'text'
                        size: bottom_nav.height-60, bottom_nav.height-60
                        md_bg_color: app.custom.colors['bottom'][:3]+[0]
                        on_release: app.wm.current_screen.edit_settings()

<DictNameWithButtons@MDBoxLayout>: #MDBoxLayout
    filter_button: filter_button
    search_button: search_button
    sorter_button: sorter_button

    left_text: ''
    right_text: ''
    anchor_x: "left"

    theme_bg_color: 'Custom'
    radius: app.radius
    spacing: 20
    orientation: 'horizontal'
    adaptive_height: True

    not_filter: False
    not_search: False


    MDAnchorLayout:
        # id: name
        size_hint_y: None
        height: name.height+2*10
        AnchoredLabel:
            id: name
            text: root.left_text
            font_size: sp(19)
            text_color: app.custom.colors['button_fg']
            size_hint_x: 1

    MDAnchorLayout:
        size_hint_x: None
        width: 3*(name.height+2*10)+2*(20)
        anchor_y: 'top'
        MDBoxLayout:
            adaptive_height: True
            spacing: 20
            BigIconButton:
                id: sorter_button
                icon: 'sort'
                size: [name.height+2*10]*2
                padding: 60,0,60,0
                on_release: app.wm.current_screen.toggle_filter(app.wm.current_screen.sorter_box,app.wm.current_screen.sorter)
            BigIconButton:
                id: search_button
                icon: 'magnify'
                size: [name.height+2*10]*2
                padding: 60,0,60,0
                md_bg_color:  app.custom.colors['head'] if root.not_search else app.custom.colors['app']
                on_release: app.wm.current_screen.toggle_search_bar()
            BigIconButton:
                id: filter_button
                icon: 'filter'
                size: [name.height+2*10]*2
                padding: 60,0,60,0
                md_bg_color:  app.custom.colors['head'] if root.not_filter else app.custom.colors['app']
                on_release: app.wm.current_screen.toggle_filter(app.wm.current_screen.filter_box,app.wm.current_screen.filter)
    
    MDAnchorLayout:
        size_hint: None, None
        width: count.width
        height: name.height+2*10
        MDLabel:
            id: count
            font_name: "CH"
            text: root.right_text
            halign: 'right'
            adaptive_width: True
            adaptive_height: True
            padding: 20,0,20,0
            font_style: 'Title'
            role: 'medium'
            theme_text_color: 'Custom'
            text_color: app.custom.colors['button_fg']