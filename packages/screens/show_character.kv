<ShowCharacter>:
    bottom_nav: bottom_nav
    scroll: scroll

    MDStackLayout:
        padding: 0,0,0,200
        MDBoxLayout:
            id: head
            adaptive_height: True
            orientation: 'horizontal'
            md_bg_color: app.custom.colors['head']
            padding: 20,20,20,20
            spacing: 20
            text_color: app.custom.colors['head_text']
            text_bg_color: app.custom.colors['head_content']

            MDStackLayout:
                adaptive_height: True
                MDBoxLayout:
                    orientation: 'horizontal'
                    adaptive_height: True
                    spacing: 10
                    MultiLineLabel:
                        id: simple
                        text: root.get_category('simple')
                        role: 'medium'
                        font_style: "Title"
                        label_height: root.default_height
                        label_bg_color: head.text_bg_color
                        text_color: head.text_color 
                        size_hint_x: 1 if self.text!="" else None
                        width: 0
                    MultiLineLabel:
                        id: traditional
                        text: root.get_category('traditional')
                        role: 'medium'
                        font_style: "Title"
                        label_height: root.default_height
                        label_bg_color: head.text_bg_color
                        text_color: head.text_color 
                        size_hint_x: 1 if self.text!="" else None
                        width: 0
                Separator:
                MDBoxLayout:
                    orientation: 'horizontal'
                    adaptive_height: True
                    MDBoxLayout:
                        size_hint: None,None
                        size: 0,root.default_height
                    MultiLineLabel:
                        id: pronunciation
                        text: root.character.pinyin
                        role: 'small'
                        font_style: "Label"
                        label_padding: 20,12,0,12
                        label_height: root.default_height
                        label_bg_color: head.text_bg_color
                        text_color: head.text_color 
            MDAnchorLayout:
                anchor_y: 'top'
                anchor_x: 'right'
                size_hint_x: None
                width: edit.size[0]
                MDStackLayout:
                    size_hint: None, None
                    width: edit.size[0]
                    height: 2*edit.size[0]+20
                    MyIconButton:
                        id: edit
                        size: 80,80
                        icon: 'pencil'
                        style: 'text'
                        on_release:  root.edit_character()
                    Separator:
                    MyIconButton:
                        size: edit.size
                        icon: 'plus'
                        style: 'text'
                        on_release: root.new_category()

        ScrollView:
            MDStackLayout:
                id: scroll
                size_hint: 1, None
                height: self.minimum_height+(66+2*10)*2
                padding: 10
                spacing: 20
                
                
    MDBottomSheet:
        id: bottom_nav
        radius: 0
        size_hint: None,None
        height: 170
        width: Window.width 
        sheet_type: "standard"
        # sheet_type: "modal"
        md_bg_color: app.custom.colors['bottom']

        BottomSheetDragHandleContainer:
            padding: 20
            adaptive_height: True
            MDAnchorLayout:
                anchor_x: 'center'
                anchor_y: 'center'
                size_hint_y: None
                height: bottom_nav.height-2*20
                MDBoxLayout:
                    orientation: 'horizontal'
                    adaptive_width: True
                    size_hint_y: None
                    height: self.parent.height
                    spacing: 50
                    MyIconButton:
                        text: 'Delete'
                        icon: 'delete'
                        style: 'text'
                        size: self.parent.height, self.parent.height
                        md_bg_color: bottom_nav.md_bg_color
                        on_release: 
                            root.del_character()
                    MyIconButton:
                        text: 'Replace'
                        icon: 'auto-upload'
                        style: 'text'
                        size: self.parent.height, self.parent.height
                        md_bg_color: bottom_nav.md_bg_color
                        on_release: 
                            root.replace_character()
                    MyIconButton:
                        text: 'Upload Image'
                        icon: 'image-plus-outline'
                        style: 'text'
                        size: self.parent.height, self.parent.height
                        md_bg_color: bottom_nav.md_bg_color
                        on_release: 
                            root.add_image()
                    MyIconButton:
                        text: 'Export'
                        icon: 'content-save'
                        style: 'text'
                        size: self.parent.height, self.parent.height
                        md_bg_color: bottom_nav.md_bg_color
                        on_release:
                            root.export_character()
                    MyIconButton:
                        text: 'Previous Character'
                        icon: 'arrow-left'
                        style: 'text'
                        size: self.parent.height, self.parent.height
                        md_bg_color: bottom_nav.md_bg_color
                        on_release: 
                            root.show_previous()
                    MyIconButton:
                        text: 'Next Character'
                        icon: 'arrow-right'
                        style: 'text'
                        size: self.parent.height, self.parent.height
                        md_bg_color: bottom_nav.md_bg_color
                        on_release: 
                            root.show_next()