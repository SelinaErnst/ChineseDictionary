
<Settings>: #MyScreen
    MDStackLayout:
        padding: 50,50,50,0
        spacing: 20
        TitleLabel:
            text: f"Settings"
        # MDStackLayout:
            # orientation: 'vertical'
        MDBoxLayout:
            radius: 20
            padding: 40
            spacing: 40
            md_bg_color: app.theme_cls.surfaceContainerColor
            size_hint_x: 1
            adaptive_height: True
            orientation: 'vertical'

            Setting:
                id: theme_style
                hint: 'Theme Style'
                text:  app.theme_cls.theme_style
                icon: 'theme-light-dark'    
                press_button: self.switch_theme
            Setting:
                id: palette
                icon: 'palette'
                hint: 'Palette'
                text:  app.theme_cls.primary_palette
                press_button: self.select_palette
                options: self.palettes
            Setting:
                id: app_directory
                setting: 'app_directory'
                hint: 'App Directory'
                text: app.get_setting('app_directory',default=True)
                icon: 'folder-open'
                press_button: self.select_directory
            Setting:
                id: import_directory
                setting: 'import_directory'
                hint: 'Import Directory'
                text: app.get_setting('import_directory')
                icon: 'folder-open'
                press_button: self.select_directory
            MDStackLayout:
                adaptive_height: True
                spacing: 20
                orientation: 'lr-tb'
                MultiLineIconTextButton:
                    text: 'Template'
                    icon: 'pencil'
                    role: 'small'
                    icon_size: sp(12)
                    padding: 15
                    on_release: root.open_file(app.get_setting('pleco_template'))
                MultiLineIconTextButton:
                    text: 'Categories'
                    icon: 'pencil'
                    role: 'small'
                    icon_size: sp(12)
                    padding: 15
                    on_release: root.open_file(app._MyApp__appdata+'defaults/'+'dictionary_categories.json')
                MultiLineIconTextButton:
                    text: 'Reset Settings'
                    icon: 'backup-restore'
                    role: 'small'
                    icon_size: sp(12)
                    padding: 15
                    on_release: app.reset_settings()

        BottomFieldButton:
            text: 'Save'
            style: 'filled'
            press_button: root.save_settings

<ShowFileContent>:
    input: input
    anchor_y: 'bottom'
    TextInput:
        id: input
        text: root.text
        font_size: sp(11)

    BottomFieldButton:
        text: 'Save'
        style: 'elevated'
        press_button: root.change_file    