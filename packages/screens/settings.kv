
<Settings>: #MyScreen
    ScrollView:
        do_scroll_x: False
        do_scroll_y: True
        MDStackLayout:
            size_hint: 1, None
            height: self.minimum_height
            padding: 50,50,50,400
            spacing: 20
            TitleLabel:
                text: 'Design Choices'
            SettingsType:
                padding: 40,60,40,40
                spacing: 60
                Setting:
                    id: theme_style
                    hint: 'Theme Style'
                    text:  app.theme_cls.theme_style
                    icon: 'theme-light-dark'    
                    press_button: self.switch_theme
                Setting:
                    id: palette
                    icon: 'palette'
                    hint: 'Palette'
                    text:  app.theme_cls.primary_palette
                    press_button: app.select_palette
                    options: self.palettes
            TitleLabel:
                text: 'Directories'
            SettingsType:
                padding: 40,60,40,40
                spacing: 60
                Setting:
                    id: app_directory
                    setting: 'app_directory'
                    hint: 'App Directory'
                    text: str(app.app_directory)
                    icon: 'folder-open'
                    press_button: self.select_directory
                    multiline: True
                Setting:
                    id: import_directory
                    setting: 'import_directory'
                    hint: 'Import Directory'
                    text: str(app.get_setting('import_directory'))
                    icon: 'folder-open'
                    press_button: self.select_directory
                    multiline: True
            TitleLabel:
                text: 'General Dictionary Settings'
            SettingsType:
                EditTemplates:
                    id: dict_template
                    title: 'Templates'
                    text: ''
                    # options: [t.strip('.chd') for t in app.get_setting('templates')]
                    cols: 1
                EditCategories:
                    id: dict_cat
                    title: 'Categories'
                    text: ''
                    options: app.get_categories()
                    cols: 1
            TitleLabel:
                text: 'Grammar Settings'
            SettingsType:
                MDGridLayout:
                    adaptive_height: True
                    spacing: 20
                    rows: 1
                    MultiLineIconTextButton:
                        text: 'Tags'
                        icon: 'pencil'
                        role: 'small'
                        icon_size: sp(12)
                        on_release: app.open_file(app.get_app_file('grammar_tags',open_file=False),allow_new=False,create_tmp=True)
                    MultiLineIconTextButton:
                        text: 'Template'
                        icon: 'pencil'
                        role: 'small'
                        icon_size: sp(12)
                        on_release: app.open_file(app.get_setting('grammar_template'),allow_new=False,create_tmp=True)
            # TitleLabel:
            #     text: 'Factory Reset'
            # SettingsType:
            #     MDGridLayout:
            #         adaptive_height: True
            #         spacing: 20
            #         rows: 1
            #         MultiLineIconTextButton:
            #             text: 'Reset'
            #             icon: 'backup-restore'
            #             role: 'small'
            #             icon_size: sp(12)
            #             on_release: 
            #                 app.reset_settings()
            #                 dict_cat.undo()
            BottomFieldButton:
                text: 'Save'
                press_button: root.save_settings

<SettingsType@MDBoxLayout>:
    radius: app.radius
    spacing: 40
    padding: 40,40,40,40
    md_bg_color: app.custom.colors['dialog_bg']
    adaptive_height: True
    orientation: 'vertical'
    title: ""