<ImageDisplay>: #MDStackLayout
    adaptive_height: True
    # md_bg_color: 'blue'
    orientation: 'rl-bt'
    spacing: 20
    image_files: {}

<ImageBox>:
    radius: app.radius
    size_hint: None, None
    size: [250,250]
    md_bg_color: app.theme_cls.onSurfaceLightColor
    on_release: 
        app.show_image(root.image_type, root.source,size=image.texture_size) if root.image_type != 'zi.tools' else app.try_urls(app.wm.current_screen.character)
    FitImage:
        id: image
        radius: app.radius
        source: root.imagefile(root.source)

<CenterImage>:
    size_hint_y: None
    height: max(root.min_h,min(root.max_h, image.height))+60
    ImageBox:
        id: image
        source: root.source
        # size: root.image_size
        # width: root.image_size[0]
        # height: root.image_size[1]
        width: max(950,min(root.width, root.image_size[0]))
        height: max(950,min(950, root.image_size[1]))
        on_release: root.msg()
