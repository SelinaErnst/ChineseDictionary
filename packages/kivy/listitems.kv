
<TableRow>: #MDBoxLayout
    orientation: "horizontal"
    adaptive_height: True
    MDLabel:
        name: "head"
        size_hint_x: None
        width: root.head_width
        text: root.head
        role: root.role
    MDLabel:
        adaptive_width: True
        text: root.content
        role: root.role
        pos_hint: {"x":0}


# = ============================================================== = #
# =                 LIST ITEM WITH BUTTON BEHAVIOR                 = #
# = ============================================================== = #


<CustomListItem>: #MDAnchorLayout
    radius: app.radius
    padding: 20,20,20,20
    md_bg_color: app.custom.colors['list_element_bg']

<MyListItem>: #CustomListItem
    anchor_x: 'center'
    size_hint_y: None
    height: 150
    font_size: None
    style: 'Body'
    role: 'small'

    on_release:
        app.dismiss_dialog()
        root.func(self.text) if root.func!=None else None
    MDLabel:
        id: label
        text: root.text
        adaptive_width: True
        style: root.style
        role: root.role
        theme_font_size: 'Custom' if root.font_size!=None else 'Primary'
        font_size: root.font_size if root.font_size!=None else sp(1)
        theme_font_name: "Custom"
        font_name: 'CH'

<LeftListItem@MyListItem>:
    anchor_x: 'left'

<OptionItem@MyListItem>:
    # font_size: sp(10)
    anchor_x: 'left'
    height: 100

<MyMultiLineItem>: #CustomListItem
    anchor_y: 'center'
    size_hint_y: None
    height: label.height+40
    padding: 30,0,30,0
    on_release:
        app.dismiss_all()
        root.func(self.text) if root.func!=None else None
    MDLabel:
        id: label
        text: root.text
        adaptive_height: True
        style: 'Label'
        role: 'medium'

<PaletteItem>: #CustomListItem
    padding: 20,0,20,0
    radius: app.radius
    on_release: 
        app.apply_palette(self.text)
    MDBoxLayout:
        MDLabel:
            id: label
            text: root.text
            role: 'small'
            # theme_font_size: 'Custom'
            # font_size: sp(9)
            size_hint_x: None
            width: 400
        MDGridLayout:
            id: color_grid
            radius: app.radius
            cols: 19

            PaletteColor:
                md_bg_color: root.color_onea
            PaletteColor:
                md_bg_color: root.color_oneb
            PaletteColor:
                md_bg_color: root.color_onec
            PaletteColor:
                md_bg_color: root.color_oned
            PaletteColor:
                md_bg_color: root.color_onee
            PaletteColor:
                md_bg_color: root.color_onef
            PaletteColor:
                md_bg_color: root.color_oneg   
            PaletteColor:
                md_bg_color: root.color_twoa
            PaletteColor:
                md_bg_color: root.color_twob
            PaletteColor:
                md_bg_color: root.color_twoc
            PaletteColor:
                md_bg_color: root.color_twod
            PaletteColor:
                md_bg_color: root.color_twoe
            PaletteColor:
                md_bg_color: root.color_twof
            PaletteColor:
                md_bg_color: root.color_trea
            PaletteColor:
                md_bg_color: root.color_treb
            PaletteColor:
                md_bg_color: root.color_trec
            PaletteColor:
                md_bg_color: root.color_tred
            PaletteColor:
                md_bg_color: root.color_tree
            PaletteColor:
                md_bg_color: root.color_tref

<PaletteColor@MDBoxLayout>: #MDBoxLayout
    theme_bg_color: "Custom" 

<GrammarItem>: #CustomListItem

    on_release: app.wm.current_screen.select_grammar(root.grammar)

    height: level.height+title.height+subtitle.height+structure.height+2*self.padding[0]
    # height: 404
    # height: 470
    padding: 30
    
    level: ""
    title: ""
    subtitle: ""
    
    level_color: app.theme_cls.onPrimaryColor
    
    MDBoxLayout:
        orientation: 'vertical'

        MDBoxLayout:
            size_hint: 1,None
            height: level.height
            orientation: 'horizontal'
            spacing: root.padding[0]
            MDAnchorLayout:
                id: level
                md_bg_color: app.custom.colors['level'+root.level]
                size_hint: None,None
                size: 2*[150]
                radius: app.radius
                MDLabel:
                    text: root.level
                    font_style: 'Title'
                    role: 'medium'
                    theme_font_size: "Custom"
                    font_size: level.size[0]-2*30
                    adaptive_width: True
                    adaptive_height: True
                    theme_text_color: 'Custom'
                    text_color: app.custom.colors['text_level'+root.level]
            ScrollView:
                do_scroll_y: 'auto'
                MDStackLayout:
                    id: tags
                    spacing: 10
                    size_hint_y: None
                    height: level.height if self.minimum_height < level.height else self.minimum_height

        MDStackLayout:
            id: infobox
            padding: 0,20,0,0
            MDBoxLayout:
                adaptive_height: True
                orientation: 'vertical'
                ChLabel:
                    id: title
                    text: root.title
                    font_style: 'Label'
                    role: 'large'
                    size_hint_y: None
                    height: self.texture_size[1]
                    text_size: self.width, None
                    halign: 'left'
                    shorten: True
                ChLabel:
                    id: subtitle
                    text: root.subtitle
                    font_style: 'Label'
                    role: 'small'
                    adaptive_height: True
                    max_lines: 2
                    padding: 0,0,0,15
                    valign: 'top'
                    halign: 'left'
                MDDivider:
            MDBoxLayout:
                adaptive_height: True
                ChLabel:
                    id: structure
                    text: root.get_category(root.grammar,'structure')
                    font_style: 'Label'
                    role: 'small'
                    adaptive_height: True
                    shorten: True
                    shorten_from: 'right'
                    padding: 0,15,0,15
                    valign: 'top'
                    halign: 'left'

<Tag>:
    size_hint: None,None
    width: tag_label.width + 20
    height: tag_label.height + 10
    md_bg_color: app.custom.colors['button_bg']
    radius: 10
    MDLabel:
        id: tag_label
        text: root.text
        text_color: app.custom.colors['button_fg']
        theme_font_size: 'Custom'
        font_size: sp(10)
        adaptive_height: True
        adaptive_width: True

<DictionaryItem>: #CustomListItem
    radius: app.radius
    on_release: app.wm.current_screen.show_char(self.character)

    size_hint_y: None
    # height: 210
    # height: simp.height+pron.height+transl.height+2*root.spacing+2*10
    height: 60+pron.height+transl.height+2*20+2*10
    spacing: 20
    image_size: root.height-2*root.spacing
    symbol_size: (root.height-2*root.spacing)/2

    char_simp: ""
    char_trad: ""
    char_pron: ""
    example: ""

    preview_image: ""
    image_type: ""
    character_img: ""

    cond_1: False
    cond_2: False
    cond_3: False
    cond_4: False
    cond_map: {'cond_1':'numeric-1-circle','cond_2':'numeric-2-circle','cond_3':'numeric-3-circle','cond_4':'numeric-4-circle'}

    MDBoxLayout:
        orientation: 'horizontal'
        MDBoxLayout:
            MDStackLayout:
                spacing: 10
                padding: 0,0,0,0
                MDBoxLayout:
                    size_hint_y: None
                    height: 60
                    orientation: 'horizontal'
                    spacing: root.padding[0]
                    ChLabel:
                        id: simp
                        text: root.char_simp
                        font_style: 'Label'
                        role: 'large'
                        adaptive_height: True
                        adaptive_width: True
                        shorten: True
                        shorten_from: 'right'
                    ChLabel:
                        id: trad
                        text: root.char_trad
                        font_style: 'Label'
                        role: 'large'
                        adaptive_height: True
                        adaptive_width: True
                        shorten: True
                        shorten_from: 'right'
                AnchoredLabel:
                    id: pron
                    text: root.char_pron
                    font_style: 'Label'
                    role: 'small'
                    multiline: False
                    min_h: self.label_size[1]+10
                    min_w: self.parent.width
                AnchoredLabel:
                    id: transl
                    text: root.example if root.example!="" else "   "
                    min_h: self.label_size[1]+10
                    min_w: self.parent.width
                    multiline: False
                    font_size: sp(8)

        MDBoxLayout:
            spacing: 0 if root.preview_image=="" else 20
            adaptive_width: True
            MDAnchorLayout:
                size: 2*[root.image_size]
                radius: app.radius
                size_hint: None, None
                opacity: 0.0 if root.preview_image=="" else 1
                ImageBox:
                    size: 2*[root.image_size]
                    source: root.preview_image
                    image_type: root.image_type
                    disabled: True
            MDAnchorLayout:
                size: 2*[root.image_size]
                radius: app.radius
                size_hint: None, None
                md_bg_color: app.custom.colors['bg']
                MDGridLayout:
                    cols:2
                    EntryType:
                        icon: self.choose_icon(root.cond_1,['',root.cond_map['cond_1']])
                        symbol_size: root.symbol_size
                    EntryType:
                        icon: self.choose_icon(root.cond_2,['',root.cond_map['cond_2']])
                        symbol_size: root.symbol_size
                    EntryType:
                        icon: self.choose_icon(root.cond_3,['',root.cond_map['cond_3']])
                        symbol_size: root.symbol_size
                    EntryType:
                        icon: self.choose_icon(root.cond_4,['',root.cond_map['cond_4']])
                        symbol_size: root.symbol_size

<EntryType>: #MDIconButton
    symbol_size: 100
    size_hint: None, None
    size: self.symbol_size, self.symbol_size
    font_size: self.symbol_size*(0.6)
    theme_font_size: 'Custom'
    theme_icon_color: 'Custom'
    icon_color: app.theme_cls.primaryColor
    allow_hover: False
    ripple_effect: False


<CategoryItem>: #MDBoxLayout
    content: content
    md_bg_color: app.custom.colors['list_head_bg']
    size_hint_y: None
    height: 2*root.padding[0]+(max(head.height,content.height) if grid.cols==2 else head.height+10+content.height)+2*10
    radius: app.radius
    padding: 5

    MDAnchorLayout:
        md_bg_color: app.custom.colors['list_element_bg']
        padding: 10
        radius: app.radius

        MDGridLayout:
            id: grid
            cols: root.cols
            rows: 0 if root.cols==2 else 2
            MDBoxLayout:
                adaptive_width: True
                adaptive_height: False if root.cols==2 else True
                # md_bg_color: app.custom.colors['list_head_bg'] if root.cols == 2 else [0,0,0,0]
                # radius: app.radius
                MDAnchorLayout:
                    size_hint_x: None
                    width: head.width
                    size_hint_y: 1 if root.cols==2 else None
                    height: head.height+10
                    anchor_x: 'left'
                    anchor_y: 'top'
                    CategoryHead:
                        id: head
                        max_width: grid.width 
                        min_width: root.head_width
                        horizontal: root.cols==2
                        title: root.title_text
                        category: root.category

            MDAnchorLayout:
                anchor_y: 'top' 
                MDStackLayout:
                    id: content
                    adaptive_height: True

<CategoryHead>: #MDAnchorLayout ...
    label: label
    title: ""
    category: ""
    
    horizontal: True
    max_width: 1000
    min_width: None
    # variable_width: label.width+2*root.padding[0]
    variable_width: label.texture_size[0] + 2 * root.padding[0]

    size_hint: None,None
    width: ((root.min_width if root.min_width!=None else root.variable_width) if root.horizontal else (root.min_width if root.min_width!=None else root.max_width))
    height: label.height+root.padding[1]
    padding: 20


    radius: app.radius
    md_bg_color: app.custom.colors['list_head_bg']
    text_color: None
    role: 'small'
    font_style: 'Label'
    # ripple_effect: True if hasattr(app.wm.current_screen,'edit_category') else False
    ripple_effect: False

    on_release: app.wm.current_screen.edit_category(root.category) if hasattr(app.wm.current_screen,'edit_category') else None
    
    MDLabel:
        id: label
        text: root.title
        font_style: root.font_style
        role: root.role
        theme_text_color: 'Custom' if root.text_color!=None else 'Primary'
        text_color: root.text_color
        adaptive_size: True

<CategoryLine>: #MDBoxLayout
    n: 20
    size_hint_y: None
    height: values.height+root.n
    size_hint_x: 1 if not root.small else None
    text: ""

    MDStackLayout:
        size_hint_x: None
        width: bullet.width+root.n*2
        MDAnchorLayout:
            size_hint: None, None
            size: [bullet.width+root.n*2,bullet.width+root.n*2] #52
            padding: 0,0,0,0
            MDBoxLayout:
                id: bullet
                md_bg_color: app.custom.colors['bullet']
                size_hint: None, None
                size: 20,20

    MDFloatLayout:
        ClickableLabel:
            id: values
            pos_hint: {'center_x': 0.5,'center_y': 0.5}
            text: root.text
            font_style: 'Label'
            role: 'small'
            adaptive_height: True
            allow_copy: True
            on_release: 
                app.open_url(root.text)
                app.find_grammar(entry=root.text)
                app.find_character(character=root.text,key='simple')
            on_copy: app.test(self.text)
                
<CategoryText>: #MDBoxLayout
    n: 20
    size_hint_y: None
    height: values.height+root.n
    size_hint_x: 1 if not root.small else None
    text: ""

    MDFloatLayout:
        ClickableLabel:
            padding: 25,0,25,0
            id: values
            pos_hint: {'center_x': 0.5,'center_y': 0.5}
            text: root.text
            font_style: 'Label'
            role: 'small'
            adaptive_height: True
            allow_copy: True
            on_release: app.open_url(root.text)
            on_copy: app.test(self.text)

<RemovableCategoryLine>: #MDBoxLayout
    n: 20*2
    size_hint_y: None
    height: values.height+root.n
    size_hint_x: 1
    text: ""

    MDFloatLayout:
        size_hint_x: None
        width: bullet.width+40
        MDAnchorLayout:
            pos_hint: {'center_x': 0.5,'top': 1}
            size_hint: None, None
            size: [bullet.width,52] # 52 because of Label,small
            padding: 0,root.n,0,0
            MDBoxLayout:
                id: bullet
                md_bg_color: app.custom.colors['bullet']
                size_hint: None, None
                size: 20,20

    MDFloatLayout:
        ClickableLabel:
            id: values
            pos_hint: {'center_x': 0.5,'center_y': 0.5}
            text: root.text
            font_style: 'Label'
            role: 'small'
            adaptive_height: True
            allow_copy: True
            on_release: 
                app.open_url(root.text)
                app.find_character(root.data)
            on_copy: app.test(self.text)
    
    MDFloatLayout:
        size_hint_x: None
        width: button.width+80+20
        # md_bg_color: 'red'
        MDBoxLayout:
            pos_hint: {'right': 1,'top': 1}
            padding: 0,root.n/2,0,0
            # md_bg_color: 'black'
            adaptive_width: True
            adaptive_height: True
            spacing: 30
            orientation: 'horizontal'
            BigIconButton:
                id: button
                icon: 'pencil'
                size_hint: None, None
                size: 70,70
                on_release: root.edit_line()
                disabled: not root.editable
            BigIconButton:
                icon: 'minus'
                size_hint: None, None
                size: button.size
                on_release: root.remove_line()
                disabled: not root.editable
                