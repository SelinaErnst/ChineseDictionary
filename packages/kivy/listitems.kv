
<TableRow>: #MDBoxLayout
    orientation: "horizontal"
    adaptive_height: True
    MDLabel:
        name: "head"
        size_hint_x: None
        width: root.head_width
        text: root.head
        role: root.role
    MDLabel:
        adaptive_width: True
        text: root.content
        role: root.role
        pos_hint: {"x":0}



# = ============================================================== = #
# =                 LIST ITEM WITH BUTTON BEHAVIOR                 = #
# = ============================================================== = #


<CustomListItem>: #MDAnchorLayout
    radius: 20
    padding: 20,20,20,20
    md_bg_color: app.custom.colors['list_element_bg']

<MyListItem>: #CustomListItem
    anchor_x: 'center'
    size_hint_y: None
    height: 150
    on_release:
        app.dismiss_all()
        root.func(self.text) if root.func!=None else None
    MDLabel:
        id: label
        text: root.text
        adaptive_width: True
        style: 'Label'
        role: 'medium'
        theme_font_name: "Custom"
        font_name: 'CH'

<LeftListItem@MyListItem>:
    anchor_x: 'left'

<MyMultiLineItem>: #CustomListItem
    anchor_y: 'center'
    size_hint_y: None
    height: label.height+40
    on_release:
        app.dismiss_all()
        root.func(self.text) if root.func!=None else None
    MDLabel:
        id: label
        text: root.text
        adaptive_height: True
        style: 'Label'
        role: 'medium'

<PaletteItem>: #CustomListItem
    padding: 20,0,20,0
    radius: 20
    on_release: 
        app.apply_palette(self.text)
    MDBoxLayout:
        MDLabel:
            id: label
            text: root.text
            role: 'small'
            # theme_font_size: 'Custom'
            # font_size: sp(9)
            size_hint_x: None
            width: 400
        MDGridLayout:
            id: color_grid
            radius: 20
            cols: 19

            PaletteColor:
                md_bg_color: root.color_onea
            PaletteColor:
                md_bg_color: root.color_oneb
            PaletteColor:
                md_bg_color: root.color_onec
            PaletteColor:
                md_bg_color: root.color_oned
            PaletteColor:
                md_bg_color: root.color_onee
            PaletteColor:
                md_bg_color: root.color_onef
            PaletteColor:
                md_bg_color: root.color_oneg   
            PaletteColor:
                md_bg_color: root.color_twoa
            PaletteColor:
                md_bg_color: root.color_twob
            PaletteColor:
                md_bg_color: root.color_twoc
            PaletteColor:
                md_bg_color: root.color_twod
            PaletteColor:
                md_bg_color: root.color_twoe
            PaletteColor:
                md_bg_color: root.color_twof
            PaletteColor:
                md_bg_color: root.color_trea
            PaletteColor:
                md_bg_color: root.color_treb
            PaletteColor:
                md_bg_color: root.color_trec
            PaletteColor:
                md_bg_color: root.color_tred
            PaletteColor:
                md_bg_color: root.color_tree
            PaletteColor:
                md_bg_color: root.color_tref

<PaletteColor@MDBoxLayout>: #MDBoxLayout
    theme_bg_color: "Custom" 

<GrammarItem>: #CustomListItem

    on_release: app.wm.current_screen.select_grammar(root.grammar)

    # height: max(288, min(title.height+subtitle.height+structure.height+2*self.padding[0], 404))
    # height: 404
    height: 450
    padding: 30
    
    level: ""
    title: ""
    subtitle: ""
    
    level_color: app.theme_cls.onPrimaryColor
    
    MDBoxLayout:
        orientation: 'vertical'

        MDBoxLayout:
            size_hint: 1,None
            height: level.height
            orientation: 'horizontal'
            spacing: root.padding[0]
            MDAnchorLayout:
                id: level
                md_bg_color: app.custom.colors['level'+root.level]
                size_hint: None,None
                size: 2*[100]
                radius: 20
                MDLabel:
                    text: root.level
                    font_style: 'Title'
                    role: 'small'
                    adaptive_width: True
                    adaptive_height: True
                    # theme_text_color: 'Custom'
                    text_color: app.custom.colors['text_level'+root.level]
            MDStackLayout:
                id: tags
                spacing: 10

        MDStackLayout:
            id: infobox
            padding: 0,20,0,0
            MDBoxLayout:
                adaptive_height: True
                orientation: 'vertical'
                ChLabel:
                    id: title
                    text: root.title
                    font_style: 'Label'
                    role: 'large'
                    size_hint_y: None
                    height: self.texture_size[1]
                    text_size: self.width, None
                    halign: 'left'
                    shorten: True
                ChLabel:
                    id: subtitle
                    text: root.subtitle
                    font_style: 'Label'
                    role: 'small'
                    adaptive_height: True
                    max_lines: 2
                    padding: 0,0,0,15
                    valign: 'top'
                    halign: 'left'
                MDDivider:
            MDBoxLayout:
                adaptive_height: True
                ChLabel:
                    id: structure
                    text: root.get_category(root.grammar,'structure')
                    font_style: 'Label'
                    role: 'small'
                    adaptive_height: True
                    shorten: True
                    shorten_from: 'right'
                    padding: 0,15,0,0
                    valign: 'top'
                    halign: 'left'

<Tag>:
    size_hint: None,None
    width: tag_label.width + 20
    height: tag_label.height + 10
    md_bg_color: app.custom.colors['button_bg']
    radius: 5
    MDLabel:
        id: tag_label
        text: root.text
        text_color: app.custom.colors['button_fg']
        theme_font_size: 'Custom'
        font_size: sp(7)
        adaptive_height: True
        adaptive_width: True

<DictionaryItem>: #CustomListItem
    radius: 20
    on_release: app.wm.current_screen.show_char(self.character)

    size_hint_y: None
    height: 210
    spacing: 20
    image_size: root.height-2*root.spacing
    symbol_size: (root.height-2*root.spacing)/2

    char_simp: ""
    char_trad: ""
    char_pron: ""
    translation: ""

    preview_image: ""
    character_img: ""

    is_radical: False
    is_measure_word: False
    is_grammatical: False
    has_translation: False

    MDBoxLayout:
        orientation: 'horizontal'
        MDBoxLayout:
            MDStackLayout:
                spacing: 10
                padding: 0,0,15,0
                MDBoxLayout:
                    size_hint_y: None
                    height: 58
                    orientation: 'horizontal'
                    spacing: root.padding[0]+10
                    ChLabel:
                        id: simp
                        text: root.char_simp
                        font_style: 'Label'
                        role: 'large'
                        adaptive_height: True
                        adaptive_width: True
                        shorten: True
                        shorten_from: 'right'
                    ChLabel:
                        id: trad
                        text: root.char_trad
                        font_style: 'Label'
                        role: 'large'
                        adaptive_height: True
                        adaptive_width: True
                        shorten: True
                        shorten_from: 'right'
                ChLabel:
                    id: pron
                    text: root.char_pron
                    font_style: 'Label'
                    role: 'small'
                    adaptive_height: True
                    shorten: True
                    shorten_from: 'right'
                ChLabel:
                    id: transl
                    text: root.translation
                    adaptive_height: True
                    shorten: True
                    shorten_from: 'right'
                    theme_font_size: 'Custom'
                    font_size: sp(8)

        MDBoxLayout:
            spacing: 0 if root.preview_image=="" else 20
            adaptive_width: True
            MDAnchorLayout:
                size: 2*[root.image_size]
                radius: 20
                size_hint: None, None
                opacity: 0.0 if root.preview_image=="" else 1
                ImageBox:
                    size: 2*[root.image_size]
                    source: root.preview_image
            MDAnchorLayout:
                size: 2*[root.image_size]
                radius: 20
                size_hint: None, None
                md_bg_color: app.custom.colors['bg']
                MDGridLayout:
                    cols:2
                    EntryType:
                        icon: self.choose_icon(root.has_translation,['','translate'])
                        symbol_size: root.symbol_size
                    EntryType:
                        icon: self.choose_icon(root.is_radical,['','alpha-r-box'])
                        symbol_size: root.symbol_size
                    EntryType:
                        icon: self.choose_icon(root.is_measure_word,['','scale-unbalanced'])
                        symbol_size: root.symbol_size
                    EntryType:
                        icon: self.choose_icon(root.is_grammatical,['','bookshelf'])
                        symbol_size: root.symbol_size

<EntryType>: #MDIconButton
    symbol_size: 100
    size_hint: None, None
    size: self.symbol_size, self.symbol_size
    font_size: self.symbol_size*(0.6)
    theme_font_size: 'Custom'
    theme_icon_color: 'Custom'
    icon_color: app.theme_cls.primaryColor
    allow_hover: False
    ripple_effect: False


<CategoryItem>: #MDBoxLayout
    content: content
    md_bg_color: app.custom.colors['list_head_bg']
    size_hint_y: None
    height: 2*root.padding[0]+(max(head.height,content.height) if grid.cols==2 else head.height+10+content.height)+2*10
    radius: 20
    padding: 5

    MDAnchorLayout:
        md_bg_color: app.custom.colors['list_element_bg']
        padding: 10
        radius: 20

        MDGridLayout:
            id: grid
            cols: root.cols

            rows: 0 if root.cols==2 else 2
            MDBoxLayout:
                adaptive_width: True
                adaptive_height: False if root.cols==2 else True
                MDAnchorLayout:
                    size_hint_x: None
                    width: head.width
                    size_hint_y: 1 if root.cols==2 else None
                    height: head.label.height+20+10
                    anchor_x: 'left'
                    anchor_y: 'top'
                    CategoryHead:
                        id: head
                        max_width: grid.width 
                        min_width: root.head_width
                        horizontal: root.cols==2
                        title: root.title_text
                        category: root.category

            MDAnchorLayout:
                anchor_y: 'top' 
                MDStackLayout:
                    id: content
                    adaptive_height: True

<CategoryHead>: #MDAnchorLayout ...
    label: label
    title: ""
    category: ""
    md_bg_color: app.custom.colors['list_head_bg']
    radius: 20
    horizontal: True
    size_hint: None,None
    height: label.height+20
    max_width: 1000
    min_width: None
    variable_width: label.width+2*20
    width: ((root.min_width if root.min_width!=None else root.variable_width) if root.horizontal else (root.min_width if root.min_width!=None else root.max_width))

    on_release: app.wm.current_screen.edit_category(root.category)

    MDLabel:
        id: label
        text: root.title
        font_style: 'Label'
        role: 'small'
        adaptive_height: True
        adaptive_width: True

<CategoryLine>: #MDBoxLayout
    n: 20
    size_hint_y: None
    height: values.height+root.n
    size_hint_x: 1 if not root.small else None
    text: ""

    MDFloatLayout:
        size_hint_x: None
        width: bullet.width+root.n*2
        MDAnchorLayout:
            pos_hint: {'center_x': 0.5,'top': 1}
            size_hint: None, None
            size: [bullet.width,52] # 52 because of Label,small
            padding: 0,root.n,0,0
            MDBoxLayout:
                id: bullet
                md_bg_color: app.custom.colors['bullet']
                size_hint: None, None
                size: 20,20

    MDFloatLayout:
        ClickableLabel:
            id: values
            pos_hint: {'center_x': 0.5,'center_y': 0.5}
            text: root.text
            font_style: 'Label'
            role: 'small'
            adaptive_height: True
            allow_copy: True
            on_release: 
                app.open_url(root.text)
                app.show_grammar(entry=root.text)
            on_copy: app.test(self.text)
                
<CategoryText>: #MDBoxLayout
    n: 20
    size_hint_y: None
    height: values.height+root.n
    size_hint_x: 1 if not root.small else None
    text: ""

    MDFloatLayout:
        ClickableLabel:
            padding: 25,0,25,0
            id: values
            pos_hint: {'center_x': 0.5,'center_y': 0.5}
            text: root.text
            font_style: 'Label'
            role: 'small'
            adaptive_height: True
            allow_copy: True
            on_release: app.open_url(root.text)
            on_copy: app.test(self.text)

<RemovableCategoryLine>: #MDBoxLayout
    n: 20*2
    size_hint_y: None
    height: values.height+root.n
    size_hint_x: 1
    text: ""

    MDFloatLayout:
        size_hint_x: None
        width: bullet.width+40
        MDAnchorLayout:
            pos_hint: {'center_x': 0.5,'top': 1}
            size_hint: None, None
            size: [bullet.width,52] # 52 because of Label,small
            padding: 0,root.n,0,0
            MDBoxLayout:
                id: bullet
                md_bg_color: app.custom.colors['bullet']
                size_hint: None, None
                size: 20,20

    MDFloatLayout:
        ClickableLabel:
            id: values
            pos_hint: {'center_x': 0.5,'center_y': 0.5}
            text: root.text
            font_style: 'Label'
            role: 'small'
            adaptive_height: True
            allow_copy: True
            on_release: 
                app.open_url(root.text)
                app.find_character(root.data)
            on_copy: app.test(self.text)
    
    MDFloatLayout:
        size_hint_x: None
        width: button.width+80+20
        # md_bg_color: 'red'
        MDBoxLayout:
            pos_hint: {'right': 1,'top': 1}
            padding: 0,root.n/2,0,0
            # md_bg_color: 'black'
            adaptive_width: True
            adaptive_height: True
            spacing: 30
            orientation: 'horizontal'
            MyIconButton:
                id: button
                icon: 'pencil'
                size_hint: None, None
                size: 70,70
                on_release: root.edit_line()
                disabled: not root.editable
            MyIconButton:
                icon: 'minus'
                size_hint: None, None
                size: button.size
                on_release: root.remove_line()
                disabled: not root.editable