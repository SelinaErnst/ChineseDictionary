<CustomDialog>:
    support: support
    content: content
    decision: decision
    padding: 40
    md_bg_color: app.custom.colors['bg_overlay']

    title: 'TITLE'
    support_text: ''
    dialog_padding: 40,40
    dialog_width: None
    box_pos: {'center_x':.5,'top':.98}

    title_font_style: 'Title'
    title_font_role: 'large'

    MDBoxLayout:
        id: box
        radius: app.radius
        pos_hint: root.box_pos
        y: 20
        md_bg_color: app.custom.colors['dialog_bg']
        padding: root.dialog_padding
        orientation: 'vertical'
        adaptive_height: True
        size_hint_x: None
        width: root.width-(2*root.padding) if root.dialog_width==None else root.dialog_width
        MultiLineLabel:
            id: title_label
            text: root.title
            font_style: root.title_font_style
            role: root.title_font_role
            halign: 'center'
        MDDivider:
        MultiLineLabel:
            id: support
            text: root.support_text
            padding: (0,10,0,10) if self.text!="" else (0,0,0,10)
            label_padding: 0,50,0,50
        MDBoxLayout:
            id: content
            orientation: 'vertical'
            spacing: 20
            size_hint_y: None
            height: self.minimum_height

        MDBoxLayout:
            id: decision
            adaptive_height: True
            orientation: 'vertical'


<ChooseAppDirectory>: #CustomDialog
    title: 'Choose Location for App Documents'
    support_text: 'This app uses a chosen directory to store dictionaries and user settings.'
    accept_func:  root.save_app_dir
    deny_func:  root.save_default_app_dir

<ShowPaletteOptions>: #CustomDialog
    title: 'Primary Palette'
    dialog_padding: 10,40

<EditElement>: #CustomDialog
    # box_pos: {'center_x': .5,'center_y': 0.7}

<ConfirmDecision>: #CustomDialog
    dialog_width: 850
    box_pos: {'center_x':.5,'center_y':.5}
<ConfirmDelete>: #ConfirmDecision
    title: 'Delete\n'+root.name
<ConfirmExport>: #ConfirmDecision
    title: 'Export\n'+root.name
<ConfirmUnsaved>: #ConfirmDecision
    title: 'Save Changes to\n'+root.name if root.name!="" else "Save Changes"

<GrantAccess>: #CustomDialog
    title: 'Grant Access To Storage'
    # accept_func:  root.permissions_external_storage
    # deny_func:  root.permission_denied
    confirm_text: 'Accept'
    deny_text: 'Return'
    # dialog_width: 850

<ConfirmFileChoice>:
    title: 'Preview'

<Options>: #MDBoxLayout
    scroll: scroll
    size_hint_y: None
    height: max(root.min_h,min(root.max_h, scroll.minimum_height)) if root.is_open else 0
    scroll_spacing: 20
    ScrollView:
        size_hint_y: None
        height: root.height
        do_scroll_x: False
        do_scroll_y: True
        MDStackLayout:
            id: scroll
            size_hint: 1, None
            height: self.minimum_height
            padding: 20,20,20,0
            spacing: root.scroll_spacing
            include: []
            exclude: []

<LazyOptions>: #MDBoxLayout
    rv_scroll: rv_scroll
    size_hint_y: None
    itemclass: 'MyListItem'
    height: max(root.min_h,min(root.max_h, scroll.minimum_height))
    scroll_spacing: 20

    MDRecycleView:
        id: rv_scroll
        viewclass: root.itemclass
        scroll_type: ['bars', 'content']
        bar_width: 20
        do_scroll_x: False
        do_scroll_y: True
        RecycleBoxLayout:
            id: scroll
            orientation: "vertical"
            size_hint: 1, None
            height: self.minimum_height
            default_size_hint: 1, None
            default_height: None
            spacing: root.scroll_spacing

<MakeSimpleDecision>: #MDBoxLayout
    orientation: 'vertical'
    adaptive_height: True
    MDDivider:
    MDBoxLayout:
        padding: 0,40,0,0
        adaptive_height: True
        spacing: 40
        Widget:
        BigIconButton:
            radius: app.radius
            size_hint: None, None
            size: root.button_width, root.button_width
            icon: root.deny_icon
            md_bg_color: app.custom.colors['dialog_button_bg']
            font_color: app.custom.colors['dialog_button_fg']
            on_release: 
                app.dismiss_all()
                root.deny_func() if root.deny_func!=None else None
        # Widget:
        BigIconButton:
            radius: app.radius
            size_hint: None, None
            size: root.button_width, root.button_width
            icon: root.confirm_icon
            md_bg_color: app.custom.colors['dialog_button_bg']
            font_color: app.custom.colors['dialog_button_fg']
            on_release: 
                app.dismiss_all()
                root.accept_func() if root.accept_func!=None else None
        # Widget:

<MakeDecision>: #MDBoxLayout
    orientation: 'vertical'
    adaptive_height: True
    MDDivider:
    MDBoxLayout:
        padding: 0,40,0,0
        adaptive_height: True
        # Widget:
        RigidIconTextButton:
            width: root.button_width
            icon: root.deny_icon
            text: root.deny_text
            md_bg_color: app.custom.colors['dialog_button_bg']
            font_color: app.custom.colors['dialog_button_fg']
            role: 'medium'
            on_release: 
                app.dismiss_all()
                root.deny_func() if root.deny_func!=None else None
        Widget:
        RigidIconTextButton:
            width: root.button_width
            icon: root.confirm_icon
            text: root.confirm_text
            role: 'medium'
            md_bg_color: app.custom.colors['dialog_button_bg']
            font_color: app.custom.colors['dialog_button_fg']
            on_release: 
                app.dismiss_all()
                root.accept_func() if root.accept_func!=None else None
        # Widget:

<DoAction>:
    orientation: 'vertical'
    adaptive_height: True
    MDDivider:
    MDBoxLayout:
        padding: 0,40,0,0
        adaptive_height: True
        Widget:
        RigidIconTextButton:
            width: root.button_width
            icon: root.icon
            text: root.text
            md_bg_color: app.custom.colors['dialog_button_bg']
            font_color: app.custom.colors['dialog_button_fg']
            role: 'medium'
            on_release: 
                app.dismiss_all()
                root.action() if root.action!=None else None
        MDAnchorLayout:
            anchor_x: 'right'
            BigIconButton:
                icon: 'close'
                md_bg_color: app.custom.colors['dialog_button_bg']
                font_color: app.custom.colors['dialog_button_fg']
                on_release: app.dismiss_all()

<SimpleClose>:
    icon: 'close'
    adaptive_height: True
    orientation: 'vertical'
    MDDivider:
    MDBoxLayout:
        padding: 0,40,0,0
        adaptive_height: True
        Widget:
        BigIconButton:
            icon: root.icon
            on_release: app.dismiss_all()
            md_bg_color: app.custom.colors['dialog_button_bg']
            font_color: app.custom.colors['dialog_button_fg']

<DictValue>: #MDBoxLayout
    input: input
    key: ""
    value: ""
    orientation: 'vertical'
    size_hint_y: None
    height: input.height
    MyTextInput:
        id: input
        font_name: "CH"
        font_size: sp(11)
        hint_text: root.key
        text: root.value

        background_color: app.custom.colors['text_input_bg']
        foreground_color: app.custom.colors['text_input_fg']

        multiline: True
        size_hint_y: None
        height: self.minimum_height
        padding: 20

<DictElement>: #MDBoxLayout
    input: input
    key: ""
    value: ""
    orientation: 'horizontal'
    size_hint_y: None
    height: key.height
    spacing: 20
    AnchoredLabel:
        id: key
        font_size: sp(11)
        text: root.key
        md_bg_color: app.custom.colors['text_input_bg']
        font_color: app.custom.colors['text_input_fg']
        size_hint_y: None
        min_h: input.height
        padding: 20
        size_hint_x: None
        width: 400
    MyTextInput:
        id: input
        font_size: sp(11)
        hint_text: root.key
        text: root.value
        background_color: app.custom.colors['text_input_bg']
        foreground_color: app.custom.colors['text_input_fg']
        size_hint_y: None
        height: self.minimum_height
        padding: 20
        theme_font_name: "Custom"
        font_name:"CH"

<DictElementDel>: #DictElement
    BigIconButton:
        icon: 'minus'
        size_hint: None, None
        size: 100,100
        on_release: root.delete()

<AddOption>: #MDBoxLayout
    orientation: 'horizontal'
    size_hint: 1,None
    height: 140
    MDAnchorLayout:
        size_hint: None,None
        size: button.width+40,root.height
        BigIconButton:
            id: button
            icon: 'plus'
            on_release: root.add_option(input.text)

    MDAnchorLayout:
        size_hint_y: None
        height: root.height
        MyTextInput:
            id: input
            font_name: "CH"
            font_size: sp(12)
            hint_text: 'new'
            multiline: False
            size_hint_y: None
            background_color: app.custom.colors['text_input_bg']
            foreground_color: app.custom.colors['text_input_fg']
            height: self.minimum_height
            padding: 20

<AddProperty>: #MDBoxLayout
    orientation: 'horizontal'
    # size_hint_y: None
    size_hint: 1,None
    height: 140
    MDAnchorLayout:
        size_hint: None,None
        size: button.width+40,root.height
        BigIconButton:
            id: button
            icon: 'plus'
            on_release: root.add_property(key.text,value.text)
            
    MDAnchorLayout:
        size_hint_y: None
        height: root.height
        MDBoxLayout:
            orientation: 'horizontal'
            spacing: 20
            size_hint_y: None
            height: key.height
            MyTextInput:
                id: key
                font_size: sp(11)
                background_color: app.custom.colors['text_input_bg']
                foreground_color: app.custom.colors['text_input_fg']
                size_hint_y: None
                padding: 20
            MyTextInput:
                id: value
                font_size: sp(11)
                background_color: app.custom.colors['text_input_bg']
                foreground_color: app.custom.colors['text_input_fg']
                size_hint_y: None
                padding: 20

<ElementInput>: #TextInput

    background_color: app.custom.colors['text_input_bg']
    foreground_color: app.custom.colors['text_input_fg']
    font_size: sp(12)
    font_name: "CH"
    multiline: True
    size_hint_y: None
    line_spacing: 10
    height: max(root.min_h,min(root.max_h, self.minimum_height))
    input_type: 'text'
    keyboard_suggestions: True
